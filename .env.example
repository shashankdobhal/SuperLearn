# Copy to .env and fill in — .env is gitignored, never commit real values.

# Postgres connection string for the DB scripts in scripts/db/.
# Local dev default (no value needed) is postgres://localhost/supernova_dev.
# Point this at your hosted Supabase project's connection string (Project
# Settings -> Database -> Connection string) to run the same scripts against
# it instead of your local Postgres.
DATABASE_URL=postgres://localhost/supernova_dev

# Google Cloud Translation API key (Cloud Translation API enabled, billing
# set up). Used by scripts/db/translate.ts --provider google.
GOOGLE_TRANSLATE_API_KEY=
